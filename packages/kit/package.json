{
  "name": "@marque/kit",
  "version": "0.1.0",
  "private": true,
  "description": "Marque UI kit: the finding card, decision prompt, pane, inline marks and the theme layer. TypeScript and plain CSS; no framework, no runtime dependencies outside the workspace.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Knitli Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/knitli/marque-kit.git",
    "directory": "packages/kit"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/render.ts",
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./marking": {
      "source": "./src/marking.ts",
      "types": "./dist/marking.d.ts",
      "default": "./dist/marking.js"
    },
    "./help": {
      "source": "./src/help.ts",
      "types": "./dist/help.d.ts",
      "default": "./dist/help.js"
    },
    "./theme": {
      "source": "./src/theme.ts",
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./theme.css": "./dist/theme.css",
    "./kit.css": "./dist/kit.css"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node --conditions=source --test 'test/*.test.ts' && vp test",
    "prepack": "vp pack"
  },
  "dependencies": {
    "@marque/kit-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^26"
  }
}
