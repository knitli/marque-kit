{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    // Source runs as written: node strips the types for the tests, Vite serves it to the demo, tsdown builds dist/.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    // Workspace packages resolve to their source (the "source" export condition), not dist/.
    "customConditions": ["source"],
    "isolatedModules": true,
    // Every export says its own type, so declarations are emitted file by file (Oxc, in vp pack).
    "isolatedDeclarations": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "apps/*/src",
    "apps/*/test",
    "vite.config.ts",
    "packages/*/vite.config.ts",
    "apps/*/vite.config.ts"
  ]
}
